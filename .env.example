# ---- URLs (public HTTPS URLs when deployed or tunnelled; no trailing slash) ----
COURIER_URL=http://localhost:4000
STORE_URL=http://localhost:4100
COURIER_PORT=4000
STORE_PORT=4100
# Address to listen on. Leave empty for every interface; use 127.0.0.1 behind a reverse proxy.
BIND_HOST=

# Set to "on" to check each purchase against the errand's purpose and ask the person when it doesn't fit.
INTENT_CHECK=
# Set to "on" to fill in the first name from PayPal. Tick "Full name" under Log in with PayPal for the app first.
PAYPAL_ASK_NAME=

# ---- Secrets (generate long random strings for anything public) ----
COURIER_SECRET=change-me-to-a-long-random-string
INTERNAL_SECRET=change-me-too
# Optional: a private Ed25519 JWK (JSON) for token signing. Generated into data/ on first run if unset.
# COURIER_SIGNING_KEY=

# ---- PayPal sandbox ----
# Leave empty to use the built-in, clearly labelled PayPal simulator.
# Dashboard: Apps & Credentials → (sandbox) your REST app → enable "Log in with PayPal" →
# Advanced settings: return URL = $COURIER_URL/auth/paypal/callback,
# share only "Account verification status" and "PayPal account ID (payer ID)".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional, for webhook signature verification (point the webhook at $STORE_URL/webhooks/paypal)
PAYPAL_WEBHOOK_ID=

# ---- AI ----
# Intent check backend preference: jev | claude | rules (always falls back to rules)
INTENT_MODEL=jev
# Jev (TypeSafe AI) is in early access; set both to enable.
JEV_API_KEY=
JEV_BASE_URL=
# Claude: used for the intent check fallback (Haiku) and the errand room agent (Opus).
ANTHROPIC_API_KEY=
INTENT_CLAUDE_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-opus-5-5

# ---- Optional ----
# Force the PayPal simulator even when credentials are set: PAYPAL_MODE=simulated
# PAYPAL_MODE=
# Where the databases and the dev signing key live.
# DATA_DIR=data
# STORE_NAME=Juniper Records
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PAYPAL_WEB_BASE=https://www.sandbox.paypal.com
# INTENT_TIMEOUT_MS=1500
